// NatureFX: hands traces to the own ray tracing engine (NFXNative, NativeEngine.cs) and back. Each trace is a
// Prepare dispatch (what the engine reads, per trace pixel, into a buffer; also resets the result buffer, which
// leaves both in the state the engine uses them in), the engine's work on Unity's queue (a render event), and an
// Unpack dispatch (the result into the shadow pass's texture).
// Prepare: sun shadows (SunShadow.hlsl). PrepareAmbient: ambient light and local light shadows
// (GetTraceSurface). PrepareShafts: light shafts (Shafts.hlsl). Clear4: resets a result buffer. Unpack, Unpack4:
// the results into textures.
#pragma kernel Prepare
#pragma kernel PrepareAmbient
#pragma kernel PrepareShafts
#pragma kernel Clear4
#pragma kernel Unpack
#pragma kernel Unpack4
#pragma kernel PrepareSurface
#pragma kernel UnpackSurface
#pragma kernel PrepareScreen
#pragma kernel PrepareReflection
#pragma kernel UnpackReflection
#pragma kernel PrepareGlass
#pragma kernel PrepareNrdGuide
#pragma kernel PrepareClouds
#pragma kernel CloudTemporal
#pragma kernel SkyAmbientSH
#pragma kernel PrepareFog
#pragma kernel PrepareFogVolume
#pragma kernel SkyCubeUnpack
#pragma kernel FogReproject
#pragma kernel FogIntegrate
#pragma kernel PrepareDlss
#pragma kernel UnpackDlss

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/ShaderLibrary/ShaderVariables.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/Material/NormalBuffer.hlsl"

TEXTURE2D_X(_NFX_SurfaceNormal);              // RTSurfaceTrace: exact normal, w distance (< 0 thin, 0 unknown)
RWStructuredBuffer<float4> _NFX_NativeSurface; // what the engine reads per pixel (2 or 3 float4)
RWStructuredBuffer<float2> _NFX_NativeSun;     // sun result per pixel
RWStructuredBuffer<float4> _NFX_NativeResult;  // ambient / local light / shaft result per pixel
RW_TEXTURE2D_X(float2, _NFX_SunOutput);
RW_TEXTURE2D_X(float4, _NFX_NativeTarget);

float4 _NFX_TargetSize;    // trace resolution: xy size, zw 1 / size
float2 _NFX_TraceJitter;   // PrepareAmbient: this frame's offset inside a trace pixel (-0.5 .. 0.5; 0 at half resolution)
float4 _NFX_RTSunDir;      // xyz towards the sun, w 1 when it is up
float4 _NFX_NativeDefault; // what a result pixel holds before the engine writes it
float4 _NFX_ShaftParams;   // x scattering (1/m), y anisotropy, z max distance (m)
float4 _NFX_NativeFrame;   // x frame index

float IGN(float2 p)
{
    return frac(52.9829189 * frac(dot(p, float2(0.06711056, 0.00583715))));
}

float2 Hash22(uint2 p, uint frame, uint i)
{
    float2 offset = float2(0.7548776662, 0.5698402910) * (frame * 4u + i) * 37.0;
    return float2(IGN(p + offset), IGN(p.yx + offset * 1.7 + 11.3));
}

uint2 TracePixel(uint2 id)
{
    float2 uv = (id + 0.5) * _NFX_TargetSize.zw;
    return min((uint2)(uv * _ScreenSize.xy), (uint2)_ScreenSize.xy - 1);
}

// The full resolution pixel a trace pixel looks at this frame (quarter resolution moves it around its block)
uint2 JitteredTracePixel(uint2 id)
{
    float2 uv = (id + 0.5 + _NFX_TraceJitter) * _NFX_TargetSize.zw;
    return min((uint2)(saturate(uv) * _ScreenSize.xy), (uint2)_ScreenSize.xy - 1);
}

// The ray origin just above the exact surface the camera ray found
bool TraceSurface(uint2 pixel, out float3 origin, out float3 n, out float3 geomN, out float viewDepth, out bool thin, out float offset)
{
    origin = 0;
    n = 0;
    geomN = 0;
    viewDepth = 0;
    thin = false;
    offset = 0;
    float depth = LOAD_TEXTURE2D_X(_CameraDepthTexture, pixel).r;
    if (depth == UNITY_RAW_FAR_CLIP_VALUE)
        return false;
    NormalData nd;
    DecodeFromNormalBuffer(pixel, nd);
    n = nd.normalWS;
    PositionInputs pos = GetPositionInput(pixel, _ScreenSize.zw, depth, UNITY_MATRIX_I_VP, UNITY_MATRIX_V);
    float3 pixelAWS = GetAbsolutePositionWS(pos.positionWS);
    float4 s = LOAD_TEXTURE2D_X(_NFX_SurfaceNormal, pixel);
    bool exact = s.w != 0.0;
    float3 cameraAWS = GetAbsolutePositionWS(float3(0, 0, 0));
    float3 surfaceAWS = exact ? cameraAWS + normalize(pixelAWS - cameraAWS) * abs(s.w) : pixelAWS;
    geomN = exact ? s.xyz : n;
    viewDepth = LinearEyeDepth(depth, _ZBufferParams);
    offset = 0.01 + viewDepth * 0.0005;
    origin = surfaceAWS + geomN * offset;
    thin = s.w < 0.0;
    return true;
}

[numthreads(8, 8, 1)]
void Prepare(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint index = id.y * (uint)_NFX_TargetSize.x + id.x;
    uint2 pixel = TracePixel(id.xy);
    float4 origin = 0;
    float3 n, geomN, o;
    float viewDepth, offset;
    bool thin;
    if (_NFX_RTSunDir.w > 0.0 && TraceSurface(pixel, o, n, geomN, viewDepth, thin, offset))
    {
        // for SunShadow.hlsl: surfaces facing away from the sun got none from HDRP; leaves lit from behind are traced
        // from their sunny side
        float3 L = _NFX_RTSunDir.xyz;
        bool backLit = thin && dot(n, L) <= 0.0;
        origin.xyz = backLit ? o - geomN * 2.0 * offset : o;
        origin.w = dot(n, L) > 0.0 || backLit ? 1.0 : 0.0;
    }
    _NFX_NativeSurface[index * 2] = origin;
    _NFX_NativeSurface[index * 2 + 1] = float4(n, asfloat(pixel.x | (pixel.y << 16)));
    _NFX_NativeSun[index] = float2(1.0, 0.0);
}

[numthreads(8, 8, 1)]
void PrepareAmbient(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint index = id.y * (uint)_NFX_TargetSize.x + id.x;
    uint2 pixel = JitteredTracePixel(id.xy);
    float3 origin, n, geomN;
    float viewDepth, offset;
    bool thin;
    bool valid = TraceSurface(pixel, origin, n, geomN, viewDepth, thin, offset);
    _NFX_NativeSurface[index * 3] = float4(origin, valid ? 1.0 : 0.0);
    _NFX_NativeSurface[index * 3 + 1] = float4(n, asfloat(pixel.x | (pixel.y << 16)));
    _NFX_NativeSurface[index * 3 + 2] = float4(geomN, viewDepth);
    _NFX_NativeResult[index] = _NFX_NativeDefault;
}

// Clouds.hlsl: each low resolution pixel's view direction, and whether any of the screen pixels it covers shows sky
// (the clouds are traced there only; the composite draws them over the sky pixels)
[numthreads(8, 8, 1)]
void PrepareClouds(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint index = id.y * (uint)_NFX_TargetSize.x + id.x;
    float2 uv = (id.xy + 0.5) * _NFX_TargetSize.zw;
    float3 dir = normalize(ComputeWorldSpacePosition(uv, UNITY_NEAR_CLIP_VALUE, UNITY_MATRIX_I_VP));
    float2 block = _ScreenSize.xy * _NFX_TargetSize.zw;
    uint2 lo = min((uint2)(id.xy * block), (uint2)_ScreenSize.xy - 1);
    uint2 hi = min((uint2)((id.xy + 1) * block), (uint2)_ScreenSize.xy - 1);
    bool sky = LOAD_TEXTURE2D_X(_CameraDepthTexture, lo).r == UNITY_RAW_FAR_CLIP_VALUE
            || LOAD_TEXTURE2D_X(_CameraDepthTexture, hi).r == UNITY_RAW_FAR_CLIP_VALUE
            || LOAD_TEXTURE2D_X(_CameraDepthTexture, uint2(lo.x, hi.y)).r == UNITY_RAW_FAR_CLIP_VALUE
            || LOAD_TEXTURE2D_X(_CameraDepthTexture, uint2(hi.x, lo.y)).r == UNITY_RAW_FAR_CLIP_VALUE;
    _NFX_NativeSurface[index] = float4(dir, sky ? 1.0 : 0.0);
    _NFX_NativeResult[index] = float4(0.0, 0.0, 0.0, 1.0);
}

// The clouds blended with their history (each frame marches them from another offset): the history is found by
// the view direction in last frame's camera (the clouds are kilometres away: its rotation is what moves them on
// screen) and kept within this frame's neighbourhood (no smearing as they drift and change).
TEXTURE2D_X(_NFX_CloudCurrent);
TEXTURE2D_X(_NFX_CloudHistory);
float4 _NFX_CloudTemporal; // x the share of this frame (1: no history)
SamplerState nfx_linear_clamp_sampler;

float4 _NFX_PrevViewX, _NFX_PrevViewY, _NFX_PrevViewZ; // last frame's world to view rotation (rows), Unity's view space
float4 _NFX_PrevTan;                                  // xy tan of last frame's half field of view (horizontal, vertical)

[numthreads(8, 8, 1)]
void CloudTemporal(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    float4 current = LOAD_TEXTURE2D_X(_NFX_CloudCurrent, id.xy);
    // the neighbourhood's mean and spread (variance clipping: a wrong history is pulled to it, not to an extreme)
    float4 m1 = 0.0, m2 = 0.0;
    for (int y = -1; y <= 1; ++y)
    for (int x = -1; x <= 1; ++x)
    {
        int2 p = clamp((int2)id.xy + int2(x, y), 0, (int2)_NFX_TargetSize.xy - 1);
        float4 v = LOAD_TEXTURE2D_X(_NFX_CloudCurrent, p);
        m1 += v;
        m2 += v * v;
    }
    m1 /= 9.0;
    float4 sigma = sqrt(max(m2 / 9.0 - m1 * m1, 0.0));
    float4 lo = m1 - 1.5 * sigma, hi = m1 + 1.5 * sigma;
    // this pixel's view direction in last frame's camera: its rotation and field of view, projected by hand (the
    // clouds are kilometres away, the camera's move does not count). Screen v runs down, like the texture's rows
    float2 uv = (id.xy + 0.5) * _NFX_TargetSize.zw;
    float3 dir = normalize(ComputeWorldSpacePosition(uv, UNITY_NEAR_CLIP_VALUE, UNITY_MATRIX_I_VP));
    float3 v = float3(dot(_NFX_PrevViewX.xyz, dir), dot(_NFX_PrevViewY.xyz, dir), dot(_NFX_PrevViewZ.xyz, dir));
    float share = _NFX_CloudTemporal.x;
    float4 result = current;
    if (share < 1.0 && v.z < -1e-3)
    {
        float2 prevUv = float2(0.5 + 0.5 * v.x / (-v.z * _NFX_PrevTan.x), 0.5 - 0.5 * v.y / (-v.z * _NFX_PrevTan.y));
        if (all(prevUv > 0.0) && all(prevUv < 1.0))
        {
            float4 history = clamp(SAMPLE_TEXTURE2D_X_LOD(_NFX_CloudHistory, nfx_linear_clamp_sampler, prevUv, 0), lo, hi);
            result = lerp(history, current, share);
        }
    }
    _NFX_NativeTarget[COORD_TEXTURE2D_X(id.xy)] = result;
}

// The sky's light (SkyAmbient.hlsl: 32 x 16 directions, equal area) as an ambient probe: projected onto L2
// spherical harmonics, convolved with the cosine lobe and divided by pi (HDRP's diffuse probe: albedo times
// SampleSH9 is the reflected radiance), packed as HDRP packs it (7 float4, SampleSH9's order).
StructuredBuffer<float4> _NFX_SkySamples;
RWStructuredBuffer<float4> _NFX_SkyProbe;
groupshared float3 sh_[64][9];

[numthreads(64, 1, 1)]
void SkyAmbientSH(uint3 id : SV_DispatchThreadID)
{
    float3 c[9];
    for (int k = 0; k < 9; ++k)
        c[k] = 0.0;
    for (uint i = id.x; i < 512; i += 64)
    {
        uint x = i % 32, y = i / 32;
        float phi = (x + 0.5) / 32.0 * 2.0 * PI;
        float cosTheta = 1.0 - 2.0 * (y + 0.5) / 16.0;
        float sinTheta = sqrt(saturate(1.0 - cosTheta * cosTheta));
        float3 n = float3(sinTheta * cos(phi), cosTheta, sinTheta * sin(phi));
        float3 L = _NFX_SkySamples[i].rgb * (4.0 * PI / 512.0);
        // Unity's order: Y00, Y1-1 (y), Y10 (z), Y11 (x), Y2-2 (xy), Y2-1 (yz), Y20, Y21 (xz), Y22
        c[0] += L * 0.282095;
        c[1] += L * 0.488603 * n.y;
        c[2] += L * 0.488603 * n.z;
        c[3] += L * 0.488603 * n.x;
        c[4] += L * 1.092548 * n.x * n.y;
        c[5] += L * 1.092548 * n.y * n.z;
        c[6] += L * 0.315392 * (3.0 * n.z * n.z - 1.0);
        c[7] += L * 1.092548 * n.x * n.z;
        c[8] += L * 0.546274 * (n.x * n.x - n.y * n.y);
    }
    for (int k2 = 0; k2 < 9; ++k2)
        sh_[id.x][k2] = c[k2];
    GroupMemoryBarrierWithGroupSync();
    if (id.x != 0)
        return;
    float3 t[9];
    for (int k3 = 0; k3 < 9; ++k3)
    {
        t[k3] = 0.0;
        for (int j = 0; j < 64; ++j)
            t[k3] += sh_[j][k3];
    }
    // cosine lobe over pi (1, 2/3, 1/4) times each basis function's constant, as SampleSH9 evaluates them
    static const float K[9] = { 0.282095 * 1.0, 0.488603 * 2.0 / 3.0, 0.488603 * 2.0 / 3.0, 0.488603 * 2.0 / 3.0,
                                1.092548 * 0.25, 1.092548 * 0.25, 0.315392 * 0.25, 1.092548 * 0.25, 0.546274 * 0.25 };
    float3 s[9];
    for (int k4 = 0; k4 < 9; ++k4)
        s[k4] = t[k4] * K[k4];
    _NFX_SkyProbe[0] = float4(s[3].r, s[1].r, s[2].r, s[0].r - s[6].r);
    _NFX_SkyProbe[1] = float4(s[3].g, s[1].g, s[2].g, s[0].g - s[6].g);
    _NFX_SkyProbe[2] = float4(s[3].b, s[1].b, s[2].b, s[0].b - s[6].b);
    _NFX_SkyProbe[3] = float4(s[4].r, s[5].r, s[6].r * 3.0, s[7].r);
    _NFX_SkyProbe[4] = float4(s[4].g, s[5].g, s[6].g * 3.0, s[7].g);
    _NFX_SkyProbe[5] = float4(s[4].b, s[5].b, s[6].b * 3.0, s[7].b);
    _NFX_SkyProbe[6] = float4(s[8].r, s[8].g, s[8].b, 1.0);
    // the sky's mean radiance (the fog's isotropic sky light): Y00's coefficient over its constant and the sphere
    _NFX_SkyProbe[7] = float4(t[0] / (0.282095 * 4.0 * PI), 1.0);
}

// Fog.hlsl: each pixel's view direction and how far the air reaches: to the surface, or over the sky as far as
// the haze matters (_NFX_ShaftParams.z)
[numthreads(8, 8, 1)]
void PrepareFog(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint index = id.y * (uint)_NFX_TargetSize.x + id.x;
    uint2 pixel = TracePixel(id.xy);
    float3 viewDir = normalize(GetPositionInput(pixel, _ScreenSize.zw, 0.5, UNITY_MATRIX_I_VP, UNITY_MATRIX_V).positionWS);
    float depth = LOAD_TEXTURE2D_X(_CameraDepthTexture, pixel).r;
    float distance = _NFX_ShaftParams.z;
    if (depth != UNITY_RAW_FAR_CLIP_VALUE)
        distance = min(length(GetPositionInput(pixel, _ScreenSize.zw, depth, UNITY_MATRIX_I_VP, UNITY_MATRIX_V).positionWS), distance);
    _NFX_NativeSurface[index] = float4(viewDir, distance);
    _NFX_NativeResult[index] = float4(0.0, 0.0, 0.0, 1.0);
}

// The engine's sky (SkyCube.hlsl: the faces one after another) into the cube map HDRP takes as its sky
RWTexture2DArray<float4> _NFX_SkyCubeTarget;
#define SKY_CUBE_SIZE 64

[numthreads(8, 8, 1)]
void SkyCubeUnpack(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= SKY_CUBE_SIZE || id.y >= SKY_CUBE_SIZE * 6)
        return;
    uint face = id.y / SKY_CUBE_SIZE;
    _NFX_SkyCubeTarget[uint3(id.x, id.y % SKY_CUBE_SIZE, face)] = _NFX_NativeResult[id.y * SKY_CUBE_SIZE + id.x];
}

// ------------------------------------------------------------------ 3D fog (FogVolume.hlsl)
// A camera aligned grid: FOG_W x FOG_H columns, FOG_D slices spread exponentially in view depth from FOG_NEAR to
// FOG_FAR (keep in step with FogVolume.hlsl and NFX_FogCommon.hlsl)
#define FOG_W 160
#define FOG_H 90
#define FOG_D 64
#define FOG_NEAR 0.5
#define FOG_FAR 3000.0
RWTexture3D<float4> _NFX_FogTarget;
Texture3D<float4> _NFX_FogSource;
float4 _NFX_FogCamDelta; // xyz this camera minus last frame's (world), w the share of this frame (1: no history)

float FogSliceDepth(float s)
{
    return FOG_NEAR * pow(FOG_FAR / FOG_NEAR, s / FOG_D);
}

// each column's view ray, scaled to view depth 1 (camera relative world space)
[numthreads(8, 8, 1)]
void PrepareFogVolume(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= FOG_W || id.y >= FOG_H)
        return;
    float2 uv = (id.xy + 0.5) / float2(FOG_W, FOG_H);
    float3 p = ComputeWorldSpacePosition(uv, 0.5, UNITY_MATRIX_I_VP);
    float3 px = ComputeWorldSpacePosition(uv + float2(1.0 / FOG_W, 0.0), 0.5, UNITY_MATRIX_I_VP);
    float3 py = ComputeWorldSpacePosition(uv + float2(0.0, 1.0 / FOG_H), 0.5, UNITY_MATRIX_I_VP);
    p /= max(-mul(UNITY_MATRIX_V, float4(p, 1.0)).z, 1e-6);
    px /= max(-mul(UNITY_MATRIX_V, float4(px, 1.0)).z, 1e-6);
    py /= max(-mul(UNITY_MATRIX_V, float4(py, 1.0)).z, 1e-6);
    // the centre ray and the steps to the next column and row (FogVolume.hlsl samples anywhere in the cell)
    uint i = (id.y * FOG_W + id.x) * 3;
    _NFX_NativeSurface[i] = float4(p, 0.0);
    _NFX_NativeSurface[i + 1] = float4(px - p, 0.0);
    _NFX_NativeSurface[i + 2] = float4(py - p, 0.0);
}

// the engine's cells into a 3D texture, blended with last frame's at the same place in the world (each frame
// traces the sun from another point in the cell)
[numthreads(8, 8, 1)]
void FogReproject(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= FOG_W || id.y >= FOG_H * FOG_D)
        return;
    uint x = id.x, y = id.y % FOG_H, s = id.y / FOG_H;
    float4 current = _NFX_NativeResult[(s * FOG_H + y) * FOG_W + x];
    float share = _NFX_FogCamDelta.w;
    float4 result = current;
    if (share < 1.0)
    {
        float2 uv = (float2(x, y) + 0.5) / float2(FOG_W, FOG_H);
        float3 dir = ComputeWorldSpacePosition(uv, 0.5, UNITY_MATRIX_I_VP);
        dir /= max(-mul(UNITY_MATRIX_V, float4(dir, 1.0)).z, 1e-6);
        float3 p = dir * FogSliceDepth(s + 0.5) + _NFX_FogCamDelta.xyz; // relative to last frame's camera
        float4 clip = mul(UNITY_MATRIX_PREV_VP, float4(p, 1.0));
        if (clip.w > FOG_NEAR)
        {
            float2 prevUv = clip.xy / clip.w * 0.5 + 0.5;
#if UNITY_UV_STARTS_AT_TOP
            prevUv.y = 1.0 - prevUv.y;
#endif
            float prevSlice = log(clip.w / FOG_NEAR) / log(FOG_FAR / FOG_NEAR);
            float3 coord = float3(prevUv, prevSlice);
            if (all(coord > 0.0) && all(coord < 1.0))
            {
                float4 history = _NFX_FogSource.SampleLevel(nfx_linear_clamp_sampler, coord, 0);
                result = lerp(history, current, share);
            }
        }
    }
    _NFX_FogTarget[uint3(x, y, s)] = result;
}

// along each column: the light scattered towards the camera and the transmittance up to the far end of each slice
[numthreads(8, 8, 1)]
void FogIntegrate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= FOG_W || id.y >= FOG_H)
        return;
    float2 uv = (id.xy + 0.5) / float2(FOG_W, FOG_H);
    float3 dir = ComputeWorldSpacePosition(uv, 0.5, UNITY_MATRIX_I_VP);
    float stretch = length(dir / max(-mul(UNITY_MATRIX_V, float4(dir, 1.0)).z, 1e-6)); // metres of ray per metre of depth
    float3 L = 0.0;
    float T = 1.0;
    float previous = 0.0;
    for (uint s = 0; s < FOG_D; ++s)
    {
        float4 cell = _NFX_FogSource[uint3(id.xy, s)];
        float end = FogSliceDepth(s + 1.0);
        float dt = (end - previous) * stretch;
        previous = end;
        float sigma = max(cell.a, 0.0);
        float sampleT = exp(-sigma * dt);
        L += T * (sigma > 1e-9 ? cell.rgb * (1.0 - sampleT) / sigma : cell.rgb * dt);
        T *= sampleT;
        _NFX_FogTarget[uint3(id.xy, s)] = float4(L, T);
    }
}

[numthreads(8, 8, 1)]
void PrepareShafts(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint index = id.y * (uint)_NFX_TargetSize.x + id.x;
    uint2 pixel = TracePixel(id.xy);
    float4 sample = 0;
    float coarse = 0.0;
    if (_NFX_RTSunDir.w > 0.0)
    {
        // for Shafts.hlsl: one random point along the view ray, up to the surface or the max distance
        float maxDistance = _NFX_ShaftParams.z;
        float3 viewDir = normalize(GetPositionInput(pixel, _ScreenSize.zw, 0.5, UNITY_MATRIX_I_VP, UNITY_MATRIX_V).positionWS);
        float depth = LOAD_TEXTURE2D_X(_CameraDepthTexture, pixel).r;
        float segment = maxDistance;
        if (depth != UNITY_RAW_FAR_CLIP_VALUE)
            segment = min(length(GetPositionInput(pixel, _ScreenSize.zw, depth, UNITY_MATRIX_I_VP, UNITY_MATRIX_V).positionWS), maxDistance);
        float t = Hash22(pixel, (uint)_NFX_NativeFrame.x, 9).x * segment;
        float sigma = _NFX_ShaftParams.x;
        float g = _NFX_ShaftParams.y;
        float cosTheta = dot(viewDir, _NFX_RTSunDir.xyz);
        float phase = (1.0 - g * g) / (4.0 * PI * pow(max(1.0 + g * g - 2.0 * g * cosTheta, 1e-4), 1.5));
        sample.xyz = GetAbsolutePositionWS(viewDir * t);
        sample.w = sigma * phase * exp(-sigma * t) * segment * GetCurrentExposureMultiplier();
        coarse = t > 50.0 ? 1.0 : 0.0;
    }
    _NFX_NativeSurface[index * 2] = sample;
    _NFX_NativeSurface[index * 2 + 1] = float4(asfloat(pixel.x | (pixel.y << 16)), coarse, 0.0, 0.0);
    _NFX_NativeResult[index] = 0.0;
}

[numthreads(8, 8, 1)]
void Clear4(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    _NFX_NativeResult[id.y * (uint)_NFX_TargetSize.x + id.x] = _NFX_NativeDefault;
}

[numthreads(8, 8, 1)]
void Unpack(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    _NFX_SunOutput[COORD_TEXTURE2D_X(id.xy)] = _NFX_NativeSun[id.y * (uint)_NFX_TargetSize.x + id.x];
}

[numthreads(8, 8, 1)]
void Unpack4(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    _NFX_NativeTarget[COORD_TEXTURE2D_X(id.xy)] = _NFX_NativeResult[id.y * (uint)_NFX_TargetSize.x + id.x];
}

// ------------------------------------------------------------------ surface trace (full resolution)
RW_TEXTURE2D_X(float4, _NFX_NativeTarget2);

// The point each pixel shows (absolute world space), for the engine's camera rays
[numthreads(8, 8, 1)]
void PrepareSurface(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint index = id.y * (uint)_NFX_TargetSize.x + id.x;
    uint2 pixel = min(id.xy, (uint2)_ScreenSize.xy - 1);
    float depth = LOAD_TEXTURE2D_X(_CameraDepthTexture, pixel).r;
    float4 p = 0;
    if (depth != UNITY_RAW_FAR_CLIP_VALUE)
    {
        PositionInputs pos = GetPositionInput(pixel, _ScreenSize.zw, depth, UNITY_MATRIX_I_VP, UNITY_MATRIX_V);
        p = float4(GetAbsolutePositionWS(pos.positionWS), 1.0);
    }
    _NFX_NativeSurface[index] = p;
    _NFX_NativeResult[index * 2] = 0.0;
    _NFX_NativeResult[index * 2 + 1] = 0.0;
}

// The engine's surfaces into RTSurfaceTrace's albedo (target) and normal (target 2) textures
[numthreads(8, 8, 1)]
void UnpackSurface(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint index = id.y * (uint)_NFX_TargetSize.x + id.x;
    _NFX_NativeTarget[COORD_TEXTURE2D_X(id.xy)] = _NFX_NativeResult[index * 2];
    _NFX_NativeTarget2[COORD_TEXTURE2D_X(id.xy)] = _NFX_NativeResult[index * 2 + 1];
}

// ------------------------------------------------------------------ reflections
TEXTURE2D_X(_NFX_ColorTex);                    // camera colour before the reflection composite
TEXTURE2D_X(_NFX_SurfaceAlbedo);               // RTSurfaceTrace: rgb albedo, a metallic and clear coat
RWStructuredBuffer<uint3> _NFX_NativeScreen;   // per full resolution pixel: colour (4 halves), linear depth
float4 _NFX_ReflPrepare;                       // x roughness cutoff

// The camera colour and linear depth of every pixel, for the reflections' on screen hits
[numthreads(8, 8, 1)]
void PrepareScreen(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_ScreenSize.xy))
        return;
    float3 c = LOAD_TEXTURE2D_X(_NFX_ColorTex, id.xy).rgb;
    float depth = LOAD_TEXTURE2D_X(_CameraDepthTexture, id.xy).r;
    float linear01 = depth == UNITY_RAW_FAR_CLIP_VALUE ? 1e9 : LinearEyeDepth(depth, _ZBufferParams);
    uint2 packed = uint2(f32tof16(c.r) | (f32tof16(c.g) << 16), f32tof16(c.b));
    _NFX_NativeScreen[id.y * (uint)_ScreenSize.x + id.x] = uint3(packed, asuint(linear01));
}

float3 EnvBRDF(float3 f0, float perceptualRoughness, float nv)
{
    const float4 c0 = float4(-1.0, -0.0275, -0.572, 0.022);
    const float4 c1 = float4(1.0, 0.0425, 1.04, -0.04);
    float4 r = perceptualRoughness * c0 + c1;
    float a004 = min(r.x * r.x, exp2(-9.28 * nv)) * r.x + r.y;
    float2 ab = float2(-1.04, 1.04) * a004 + r.zw;
    return f0 * ab.x + ab.y;
}

// For Reflection.hlsl: what of each trace pixel's reflection does not need the scene. The origin above
// the exact surface, the normal (exact where the G-buffer's only differs by its quantisation), the GGX alpha (a
// clear coat mirrors through its varnish) and the reflected share; a < 0: nothing to trace (sky, too rough).
[numthreads(8, 8, 1)]
void PrepareReflection(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint index = id.y * (uint)_NFX_TargetSize.x + id.x;
    uint2 pixel = TracePixel(id.xy);
    float4 a = float4(0, 0, 0, -1);
    float4 b = float4(0, 0, 0, asfloat(pixel.x | (pixel.y << 16)));
    float4 c = float4(0, 0, 0, GetCurrentExposureMultiplier());
    float depth = LOAD_TEXTURE2D_X(_CameraDepthTexture, pixel).r;
    if (depth != UNITY_RAW_FAR_CLIP_VALUE)
    {
        NormalData nd;
        DecodeFromNormalBuffer(pixel, nd);
        float4 surface = LOAD_TEXTURE2D_X(_NFX_SurfaceAlbedo, pixel);
        float4 s = LOAD_TEXTURE2D_X(_NFX_SurfaceNormal, pixel);
        bool exact = s.w != 0.0;
        bool coated = exact && surface.a > 0.495;
        // chrome (plating, chrome wraps, polished rims): a smooth metal mirrors like the varnish does, sharp and along
        // the mesh's own normal; HDRP's roughness and normal map left it grainy and dull (NFX_RTReflect ReflRoughness)
        float metalNow = exact ? saturate((surface.a - (surface.a > 0.495 ? 0.5 : 0.0)) / 0.49) : 0.0;
        bool chrome = exact && !coated && metalNow >= 0.85 && nd.perceptualRoughness <= 0.25;
        float roughness = coated ? min(nd.perceptualRoughness, 0.04) : chrome ? min(nd.perceptualRoughness, 0.03) : nd.perceptualRoughness;
        if (roughness <= _NFX_ReflPrepare.x)
        {
            PositionInputs pos = GetPositionInput(pixel, _ScreenSize.zw, depth, UNITY_MATRIX_I_VP, UNITY_MATRIX_V);
            float3 n = nd.normalWS;
            float3 V = GetWorldSpaceNormalizeViewDir(pos.positionWS);
            float3 pixelAWS = GetAbsolutePositionWS(pos.positionWS);
            float3 cameraAWS = GetAbsolutePositionWS(float3(0, 0, 0));
            float3 albedo = exact ? surface.rgb : 0.3;
            float metallic = exact ? saturate((surface.a - (surface.a > 0.495 ? 0.5 : 0.0)) / 0.49) : 0.0;
            float3 f0 = lerp(0.04, albedo, metallic);
            // the varnish of a clear coat is smooth whatever the paint's normal map does (orange peel, dents): it
            // mirrors along the mesh's own normal
            if (exact && (coated || chrome || dot(s.xyz, n) > 0.9995))
                n = s.xyz;
            float3 surfaceAWS = exact ? cameraAWS + normalize(pixelAWS - cameraAWS) * abs(s.w) : pixelAWS;
            float viewDepth = LinearEyeDepth(depth, _ZBufferParams);
            a = float4(surfaceAWS + n * (0.02 + viewDepth * 0.001), max(roughness * roughness, 0.002));
            b.xyz = n;
            float nv = saturate(dot(n, V));
            float3 fresnel = EnvBRDF(f0, chrome ? 0.0 : nd.perceptualRoughness, nv);
            if (coated)
            {
                // Car paint is two layers: a smooth varnish (4 % head on, rising towards grazing angles) over a
                // rough, coloured base (metal flakes in tinted paint). The traced mirror is the varnish alone; the
                // base's blurred, coloured reflection stays HDRP's, under the varnish. Mirroring the base layer's
                // colour sharply as well made the paint look like tinted chrome.
                fresnel = EnvBRDF(0.04, 0.0, nv).x;
            }
            c.rgb = fresnel;
        }
    }
    _NFX_NativeSurface[index * 3] = a;
    _NFX_NativeSurface[index * 3 + 1] = b;
    _NFX_NativeSurface[index * 3 + 2] = c;
    _NFX_NativeResult[index * 2] = 0.0;
    _NFX_NativeResult[index * 2 + 1] = 0.0;
}

// Glass reflections (Glass.hlsl): per full resolution pixel the camera ray's direction and how far the opaque
// surface is (the glass must be in front of it; the sky: far), the pixel and the exposure
[numthreads(8, 8, 1)]
void PrepareGlass(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint index = id.y * (uint)_NFX_TargetSize.x + id.x;
    uint2 pixel = TracePixel(id.xy);
    float depth = LOAD_TEXTURE2D_X(_CameraDepthTexture, pixel).r;
    // the view ray through the pixel centre, in world space (camera relative and absolute differ by a translation)
    PositionInputs pos = GetPositionInput(pixel, _ScreenSize.zw, depth == UNITY_RAW_FAR_CLIP_VALUE ? 0.5 : depth, UNITY_MATRIX_I_VP, UNITY_MATRIX_V);
    float3 toPixel = pos.positionWS - GetPrimaryCameraPosition();
    float3 dir = normalize(toPixel);
    // a little past the opaque surface: glass lying on it (a lamp lens on the body) is still found
    float maxDistance = depth == UNITY_RAW_FAR_CLIP_VALUE ? 5000.0 : length(toPixel) * 1.002 + 0.02;
    _NFX_NativeSurface[index * 2] = float4(dir, maxDistance);
    _NFX_NativeSurface[index * 2 + 1] = float4(asfloat(pixel.x | (pixel.y << 16)), GetCurrentExposureMultiplier(), 0.0, 0.0);
    _NFX_NativeResult[index] = 0.0;
}

// The engine's reflection into the reflection pass's trace (target) and distance (target 2, its r) textures
[numthreads(8, 8, 1)]
void UnpackReflection(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint index = id.y * (uint)_NFX_TargetSize.x + id.x;
    _NFX_NativeTarget[COORD_TEXTURE2D_X(id.xy)] = _NFX_NativeResult[index * 2];
    _NFX_NativeTarget2[COORD_TEXTURE2D_X(id.xy)] = _NFX_NativeResult[index * 2 + 1];
}

// NRD's guides per sun trace pixel (NFXNative Nrd.inl: SIGMA denoises the sun shadows): world normal and linear
// (perceptual) roughness, then linear view depth (1e6 for the sky, outside the denoising range) and the motion to the
// previous frame in uv (NRD wants previous - current; HDRP's motion vector is current - previous)
RWStructuredBuffer<float4> _NFX_NrdGuide;
TEXTURE2D_X(_NFX_MotionVectors);

[numthreads(8, 8, 1)]
void PrepareNrdGuide(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint index = id.y * (uint)_NFX_TargetSize.x + id.x;
    uint2 pixel = TracePixel(id.xy);
    float depth = LOAD_TEXTURE2D_X(_CameraDepthTexture, pixel).r;
    NormalData nd;
    DecodeFromNormalBuffer(pixel, nd);
    // decoded as HDRP does (BuiltinData.hlsl DecodeMotionVector): x above 1 marks a pixel without motion vectors,
    // read raw it sent the denoiser two screens away
    float4 motionBuffer = LOAD_TEXTURE2D_X(_NFX_MotionVectors, pixel);
    float2 motion = motionBuffer.x > 1.0 ? 0.0 : motionBuffer.xy;
    float viewZ = depth == UNITY_RAW_FAR_CLIP_VALUE ? 1e6 : LinearEyeDepth(depth, _ZBufferParams);
    _NFX_NrdGuide[index * 2] = float4(nd.normalWS, nd.perceptualRoughness);
    _NFX_NrdGuide[index * 2 + 1] = float4(viewZ, -motion, 0.0);
}

// ------------------------------------------------------------------ DLAA (NFXNative Dlss.inl)
// The camera's colour, motion and depth for DLSS, a uint4 per pixel: the pre-exposed colour as 4 halves, the motion to
// the previous frame in pixels (previous - current, as DLSS wants it) as 2 halves, the device depth. The motion is the
// camera's own, from its matrices without the jitter (Dlaa: what DLSS is told, the jitter left out), plus what HDRP's
// motion vectors say beyond the camera's (a car moving of itself), measured against HDRP's own matrices so whatever
// HDRP made of the jitter cancels out.
TEXTURE2D_X(_NFX_DlssColor);
RWStructuredBuffer<uint4> _NFX_DlssBuffer;
float _NFX_DlssMode; // Developer > DLAA: 0 the camera's and what moves of itself, 1 the camera's only, 2 none
float4x4 _NFX_DlssCurrentVP, _NFX_DlssPreviousVP;
// Ray Reconstruction (_NFX_DlssRR 1): the guides per pixel, a uint4: diffuse albedo rgb and specular albedo rgb as 6
// halves, the world normal octahedron encoded as 2 halves; the perceptual roughness goes in the colour's alpha
float _NFX_DlssRR;
TEXTURE2D_X(_NFX_DlssGuideDiffuse);
TEXTURE2D_X(_NFX_DlssGuideSpecular);
RWStructuredBuffer<uint4> _NFX_DlssGuides;

float2 DlssUV(float4x4 m, float4 p)
{
    float4 clip = mul(m, p);
    float2 uv = clip.xy / clip.w * 0.5 + 0.5;
#if UNITY_UV_STARTS_AT_TOP
    uv.y = 1.0 - uv.y;
#endif
    return uv;
}

[numthreads(8, 8, 1)]
void PrepareDlss(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint index = id.y * (uint)_NFX_TargetSize.x + id.x;
    float4 color = max(LOAD_TEXTURE2D_X(_NFX_DlssColor, id.xy), 0.0);
    color = min(color, 65000.0);
    float depth = LOAD_TEXTURE2D_X(_CameraDepthTexture, id.xy).r;
    bool sky = depth == UNITY_RAW_FAR_CLIP_VALUE;
    float2 motion = 0.0;
    if (_NFX_DlssMode < 1.5)
    {
        PositionInputs pos = GetPositionInput(id.xy, _ScreenSize.zw, sky ? 0.5 : depth, UNITY_MATRIX_I_VP, UNITY_MATRIX_V);
        float3 rws = pos.positionWS;
        // the sky: a direction (no parallax)
        float4 p = sky ? float4(normalize(rws - GetPrimaryCameraPosition()), 0.0) : float4(rws, 1.0);
        motion = (DlssUV(_NFX_DlssPreviousVP, p) - DlssUV(_NFX_DlssCurrentVP, p)) * _ScreenSize.xy;
        float4 motionBuffer = LOAD_TEXTURE2D_X(_NFX_MotionVectors, id.xy);
        if (_NFX_DlssMode < 0.5 && !sky && motionBuffer.x <= 1.0)
        {
            // HDRP's (current - previous, uv) against what its own matrices give for a still point there
            float2 cameraHdrp = DlssUV(UNITY_MATRIX_PREV_VP, p) - DlssUV(UNITY_MATRIX_VP, p);
            float2 own = (-motionBuffer.xy - cameraHdrp) * _ScreenSize.xy;
            if (dot(own, own) > 0.25)
                motion += own;
        }
    }
    if (_NFX_DlssRR > 0.5)
    {
        NormalData nd;
        DecodeFromNormalBuffer(id.xy, nd);
        float3 diffuse = sky ? 0.5 : LOAD_TEXTURE2D_X(_NFX_DlssGuideDiffuse, id.xy).rgb;
        float3 specular = sky ? 0.0 : LOAD_TEXTURE2D_X(_NFX_DlssGuideSpecular, id.xy).rgb;
        float2 oct = sky ? 0.0 : PackNormalOctQuadEncode(nd.normalWS);
        color.a = sky ? 1.0 : nd.perceptualRoughness;
        _NFX_DlssGuides[index] = uint4(f32tof16(diffuse.r) | (f32tof16(diffuse.g) << 16), f32tof16(diffuse.b) | (f32tof16(specular.r) << 16),
                                       f32tof16(specular.g) | (f32tof16(specular.b) << 16), f32tof16(oct.x) | (f32tof16(oct.y) << 16));
    }
    _NFX_DlssBuffer[index] = uint4(f32tof16(color.r) | (f32tof16(color.g) << 16), f32tof16(color.b) | (f32tof16(color.a) << 16),
                                   f32tof16(motion.x) | (f32tof16(motion.y) << 16), asuint(depth));
}

// DLAA's result (written back over the colour) into the camera's colour copy
[numthreads(8, 8, 1)]
void UnpackDlss(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_NFX_TargetSize.xy))
        return;
    uint4 p = _NFX_DlssBuffer[id.y * (uint)_NFX_TargetSize.x + id.x];
    _NFX_NativeTarget[COORD_TEXTURE2D_X(id.xy)] = float4(f16tof32(p.x), f16tof32(p.x >> 16), f16tof32(p.y), f16tof32(p.y >> 16));
}
