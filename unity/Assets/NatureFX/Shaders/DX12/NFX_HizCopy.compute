// NatureFX replacement for CarX's HiZ depth copy (GpuCullingConfig.copyDepthTextureShader), kernel "Copy":
// the camera depth buffer (_Src, HDRP texture array) into mip 0 of the HiZ map (_Dst).
#pragma kernel Copy

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/ShaderLibrary/TextureXR.hlsl"

TEXTURE2D_X(_Src);
RWTexture2D<float> _Dst;

[numthreads(8, 8, 1)]
void Copy(uint3 id : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(0);
    uint w, h;
    _Dst.GetDimensions(w, h);
    if (id.x >= w || id.y >= h)
        return;
    _Dst[id.xy] = LOAD_TEXTURE2D_X(_Src, id.xy).r;
}
